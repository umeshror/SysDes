---
/**
 * blind75/[slug].astro — Dynamic route: 1 template → 75 pages
 * Reads existing blind75 HTML files at build time and injects
 * the question content into the shared ProblemLayout.
 */
import ProblemLayout from '../../layouts/ProblemLayout.astro';
import data from '../../data/blind75.json';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

interface Problem {
  num: number;
  slug: string;
  name: string;
  diff: string;
  file: string;
}
interface Section {
  title: string;
  problems: Problem[];
}

const sections: Section[] = data.sections as Section[];
const allProblems = sections.flatMap(s => s.problems);

export function getStaticPaths() {
  const s: Section[] = (data.sections as Section[]);
  return s.flatMap(section =>
    section.problems.map(p => ({
      params: { slug: p.slug },
      props:  { problem: p },
    }))
  );
}

const { problem } = Astro.props;

// Extract question content from the existing HTML file
let bodyContent = '';
try {
  const filePath = resolve(process.cwd(), `blind75/${problem.file}`);
  const raw      = readFileSync(filePath, 'utf8');

  // Extract content inside <div class="main"> … </div>
  const match = raw.match(/<div\s+class="main"[^>]*>([\s\S]*?)<\/div>\s*\n\s*<script/i);
  let inner = match ? match[1] : '';

  // Remove the old sidebar nav (already in ProblemLayout)
  inner = inner.replace(/<nav\s+class="sidebar"[\s\S]*?<\/nav>/i, '');

  // Remove the wrapping question-panel div and get its contents
  const panelMatch = inner.match(/<div\s+class="question-panel[^"]*"[^>]*>([\s\S]*)<\/div>\s*$/i);
  bodyContent = (panelMatch ? panelMatch[1] : inner).trim();
} catch {
  bodyContent = `
    <div class="q-header">
      <div class="q-header-meta">
        <span class="q-number-badge"># ${problem.num}</span>
        <span class="diff-badge ${problem.diff.toLowerCase()}">${problem.diff}</span>
      </div>
      <h1 class="q-title">${problem.name}</h1>
    </div>
    <p style="color:var(--dim);margin-top:20px;">Full editorial coming soon.</p>
  `;
}
---

<ProblemLayout
  currentSlug={problem.slug}
  title={`${problem.name} — Blind 75`}
  description={`${problem.name}: ${problem.diff} difficulty. Full approach comparison, Python/Java/Go code, and FAANG interview tips.`}
  sections={sections}
  storageKey="blind75-solved"
  totalCount={75}
  sectionLabel="Blind 75"
  active="blind75"
>
  <Fragment set:html={bodyContent} />

  <!-- highlight.js (already loaded in Base.astro head, just re-run) -->
  <script is:inline>
    if (window.hljs) {
      document.querySelectorAll('pre code:not(.hljs)').forEach(el => hljs.highlightElement(el));
    }
  </script>
</ProblemLayout>

<style is:global>
  /* ── Question content shared styles */
  .q-header        { margin-bottom: 22px; }
  .q-header-meta   { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 10px; }
  .q-number-badge  {
    font-size: .72rem; font-weight: 700; padding: 3px 10px; border-radius: 5px;
    background: var(--card); border: 1px solid var(--border); color: var(--muted);
  }
  .diff-badge {
    font-size: .72rem; font-weight: 700; padding: 3px 10px; border-radius: 5px; border: 1px solid;
  }
  .diff-badge.easy   { color: #22c55e; border-color: rgba(34,197,94,.3); background: rgba(34,197,94,.08); }
  .diff-badge.medium { color: #f59e0b; border-color: rgba(245,158,11,.3); background: rgba(245,158,11,.08); }
  .diff-badge.hard   { color: #ef4444; border-color: rgba(239,68,68,.3);  background: rgba(239,68,68,.08); }

  .topic-tag {
    font-size: .65rem; font-weight: 600; padding: 2px 9px; border-radius: 4px;
    background: color-mix(in srgb, var(--accent2) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent2) 25%, transparent);
    color: var(--accent2);
  }

  .q-title   { font-size: clamp(1.5rem,3vw,2.2rem); font-weight: 800; color: var(--text); }
  .q-source  { font-size: .78rem; color: var(--muted); margin-top: 4px; }
  .q-source a { color: var(--accent); text-decoration: none; }

  .section-rule { border: none; border-top: 1px solid var(--border); margin: 20px 0; }

  /* Problem statement */
  .problem-statement h3 { font-size: .9rem; font-weight: 700; color: var(--text); margin-bottom: 8px; }
  .statement-content    { color: var(--dim); line-height: 1.8; font-size: .88rem; }

  /* Examples */
  .examples      { display: flex; flex-direction: column; gap: 12px; margin: 18px 0; }
  .example-block { background: var(--card); border: 1px solid var(--border); border-radius: 8px; overflow: hidden; }
  .example-header { background: var(--surface); padding: 6px 14px; font-size: .7rem; font-weight: 700; color: var(--muted); text-transform: uppercase; }
  .example-body   { padding: 12px 14px; font-size: .82rem; display: flex; flex-direction: column; gap: 4px; }
  .label { color: var(--muted); }
  .val   { font-family: var(--font-code); color: var(--text); }
  .explanation { color: var(--dim); font-style: italic; font-size: .8rem; }

  /* Constraints */
  .constraints { background: var(--card); border: 1px solid var(--border); border-radius: 8px; padding: 14px 16px; margin: 16px 0; }
  .constraints h4 { font-size: .8rem; font-weight: 700; color: var(--text); margin-bottom: 8px; }
  .constraints li { font-size: .82rem; color: var(--dim); margin-bottom: 3px; }

  /* Compare table */
  .approach-title { font-size: 1rem; font-weight: 700; color: var(--text); margin: 24px 0 10px; border-bottom: 1px solid var(--border); padding-bottom: 8px; }
  .compare-table { width: 100%; border-collapse: collapse; font-size: .82rem; margin-bottom: 20px; }
  .compare-table th,
  .compare-table td { text-align: left; padding: 8px 12px; border: 1px solid var(--border); color: var(--dim); }
  .compare-table th  { background: var(--surface); font-weight: 700; color: var(--text); }
  .compare-table .optimal-row td { background: color-mix(in srgb, var(--success) 5%, transparent); color: var(--text); }

  /* Complexity row */
  .complexity-row { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 10px; }
  .complexity-pill {
    display: flex; align-items: center; gap: 6px;
    background: var(--card); border: 1px solid var(--border); border-radius: 6px; padding: 5px 12px;
  }
  .cp-label { font-size: .65rem; font-weight: 700; color: var(--muted); text-transform: uppercase; }
  .cp-value { font-family: var(--font-code); font-size: .8rem; color: var(--accent); }

  /* Code tabs */
  .approach-explanation { color: var(--dim); line-height: 1.7; font-size: .85rem; margin-bottom: 12px; }
  .code-tabs { background: var(--card); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; margin: 12px 0 20px; }
  .tab-buttons { display: flex; border-bottom: 1px solid var(--border); background: var(--surface); }
  .tab-btn {
    padding: 8px 16px; font-size: .7rem; font-weight: 700; letter-spacing: .5px;
    text-transform: uppercase; font-family: var(--font-code);
    color: var(--muted); cursor: pointer; background: none;
    border: none; border-bottom: 2px solid transparent;
    transition: all var(--dur-base);
  }
  .tab-btn.active { color: var(--accent); border-bottom-color: var(--accent); }
  .tab-content     { display: none; padding: 18px; }
  .tab-content.active { display: block; }
  .code-wrap pre   { margin: 0; font-size: .8rem; line-height: 1.7; border-radius: 7px; }

  /* Flow matrix */
  .flow-matrix-container { overflow-x: auto; margin: 16px 0; }
  .flow-matrix-table { width: 100%; border-collapse: collapse; font-size: .78rem; }
  .flow-matrix-table th,
  .flow-matrix-table td { padding: 7px 12px; border: 1px solid var(--border); color: var(--dim); }
  .flow-matrix-table th  { background: var(--surface); color: var(--text); font-weight: 700; }

  /* Insight / warn / tip boxes */
  .insight, .warn-box, .interview-tips {
    border-radius: 8px; padding: 14px 16px; margin: 16px 0; font-size: .83rem;
  }
  .insight       { background: color-mix(in srgb, var(--accent) 5%, transparent); border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent); }
  .insight-title { font-weight: 700; color: var(--accent); margin-bottom: 6px; }
  .warn-box      { background: color-mix(in srgb, var(--warn) 5%, transparent); border: 1px solid color-mix(in srgb, var(--warn) 20%, transparent); }
  .warn-box-title { font-weight: 700; color: var(--warn); margin-bottom: 6px; }
  .interview-tips { background: color-mix(in srgb, var(--accent2) 5%, transparent); border: 1px solid color-mix(in srgb, var(--accent2) 20%, transparent); }
  .interview-tips h3 { font-weight: 700; color: var(--accent2); margin-bottom: 8px; }
  .interview-tips ol { margin-left: 18px; }
  .interview-tips li { color: var(--dim); margin-bottom: 4px; }

  /* Mark solved button */
  .mark-solved-btn {
    margin-top: 28px; padding: 10px 24px; border-radius: 7px;
    border: 1.5px solid var(--accent); background: transparent; cursor: pointer;
    font-size: .85rem; font-weight: 700; color: var(--accent); font-family: var(--font-body);
    transition: all var(--dur-base);
  }
  .mark-solved-btn:hover, .mark-solved-btn.solved { background: var(--accent); color: var(--bg); }
</style>
