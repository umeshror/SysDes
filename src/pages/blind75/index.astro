---
/**
 * blind75/index.astro — Blind 75 landing page
 */
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import data from '../../data/blind75.json';

const allProblems = data.sections.flatMap((s: any) => s.problems);
const total       = allProblems.length;
const easy        = allProblems.filter((p: any) => p.diff === 'Easy').length;
const medium      = allProblems.filter((p: any) => p.diff === 'Medium').length;
const hard        = allProblems.filter((p: any) => p.diff === 'Hard').length;

function diffClass(diff: string) {
  if (diff === 'Easy')   return 'diff-easy';
  if (diff === 'Hard')   return 'diff-hard';
  return 'diff-medium';
}
---

<Base
  title="Blind 75 — FAANG Coding Interview Problems"
  description="Master the 75 essential LeetCode problems that have appeared repeatedly in FAANG interviews — with Python, Java, Go code and FAANG-depth explanations."
>
  <Navbar active="blind75" />

  <!-- Hero -->
  <header class="hero container">
    <div class="hero-badge">
      <span class="dot"></span>  NeetCode Blind 75 — FAANG Essentials
    </div>
    <h1>Blind <span class="accent">75</span></h1>
    <p>
      The 75 most important coding problems that appear in FAANG interviews —
      curated by the community, solved with multiple approaches, full editorial depth.
    </p>
    <div class="stats">
      <div class="stat"><span class="stat-val">{total}</span><span class="stat-label">Problems</span></div>
      <div class="stat"><span class="stat-val diff-easy">{easy}</span><span class="stat-label">Easy</span></div>
      <div class="stat"><span class="stat-val diff-medium">{medium}</span><span class="stat-label">Medium</span></div>
      <div class="stat"><span class="stat-val diff-hard">{hard}</span><span class="stat-label">Hard</span></div>
    </div>

    <!-- Progress bar -->
    <div class="progress-card">
      <div class="progress-row">
        <span>Your Progress</span>
        <span id="progress-label">0 / {total} solved</span>
      </div>
      <div class="progress-bar-wrap">
        <div class="progress-bar-fill" id="progress-bar"></div>
      </div>
    </div>
  </header>

  <!-- Problem list by section -->
  <main class="container sections">
    {data.sections.map((section: any) => (
      <section class="section">
        <h2 class="section-title">{section.title} <span class="section-count">{section.problems.length}</span></h2>
        <div class="problem-grid">
          {section.problems.map((p: any) => (
            <a href={`/blind75/${p.slug}/`} class="problem-card" data-slug={p.slug}>
              <div class="pc-left">
                <span class="pc-num">{p.num}</span>
                <span class="pc-check" id={`chk-${p.slug}`}></span>
              </div>
              <div class="pc-body">
                <span class="pc-name">{p.name}</span>
                <span class:list={['pc-diff', diffClass(p.diff)]}>{p.diff}</span>
              </div>
              <span class="pc-arrow">→</span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </main>

  <!-- CTA -->
  <div class="bottom-cta container">
    <p>Also study:</p>
    <div class="cta-row">
      <a href="/top150/"  class="btn btn-outline">Top 150 →</a>
      <a href="/patterns/" class="btn btn-outline">20 Patterns →</a>
      <a href="/sysdes/"  class="btn btn-primary">System Design →</a>
    </div>
  </div>

</Base>

<style>
  /* ── Hero */
  .hero {
    padding: 64px 2rem 48px; text-align: center; max-width: 760px; margin: 0 auto;
  }
  .hero-badge {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--card); border: 1px solid var(--border);
    border-radius: 999px; padding: 5px 16px; font-size: .72rem; color: var(--muted); margin-bottom: 16px;
  }
  .dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--accent); box-shadow: 0 0 8px var(--accent);
    animation: pulse 2s infinite;
  }
  @keyframes pulse { 0%,100%{opacity:1;}50%{opacity:.4;} }
  .hero h1 { font-size: clamp(2.5rem,6vw,4rem); font-weight: 800; margin-bottom: 14px; }
  .accent { color: var(--accent); }
  .hero p { color: var(--dim); line-height: 1.8; max-width: 560px; margin: 0 auto 28px; }

  .stats { display: flex; justify-content: center; gap: 40px; flex-wrap: wrap; margin-bottom: 28px; }
  .stat { text-align: center; }
  .stat-val   { display: block; font-size: 1.8rem; font-weight: 800; }
  .stat-label { font-size: .65rem; text-transform: uppercase; letter-spacing: .5px; color: var(--muted); }
  .diff-easy   { color: #22c55e; }
  .diff-medium { color: #f59e0b; }
  .diff-hard   { color: #ef4444; }

  .progress-card {
    max-width: 400px; margin: 0 auto; background: var(--card);
    border: 1px solid var(--border); border-radius: 10px; padding: 14px 18px 16px;
  }
  .progress-row { display: flex; justify-content: space-between; font-size: .73rem; color: var(--muted); margin-bottom: 8px; }
  .progress-bar-wrap { background: var(--border); border-radius: 4px; height: 5px; }
  .progress-bar-fill { background: linear-gradient(90deg, var(--accent), var(--accent2)); height: 100%; border-radius: 4px; width: 0; transition: width .5s; }

  /* ── Sections */
  .sections { padding-bottom: 64px; }
  .section { margin-bottom: 36px; }
  .section-title {
    font-size: .78rem; font-weight: 700; text-transform: uppercase; letter-spacing: .8px;
    color: var(--muted); margin-bottom: 10px;
    display: flex; align-items: center; gap: 8px;
  }
  .section-count {
    background: var(--card); border: 1px solid var(--border);
    border-radius: 999px; padding: 1px 8px; font-size: .65rem; font-weight: 600;
  }

  .problem-grid { display: flex; flex-direction: column; gap: 4px; }
  .problem-card {
    display: flex; align-items: center; gap: 10px;
    padding: 10px 14px; border-radius: 8px;
    background: var(--card); border: 1px solid var(--border);
    text-decoration: none; transition: all var(--dur-base) var(--ease);
  }
  .problem-card:hover { border-color: var(--accent); transform: translateX(3px); }
  .problem-card.solved { border-color: rgba(34,197,94,.3); }

  .pc-left  { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
  .pc-num   { font-size: .7rem; font-weight: 700; color: var(--muted); width: 28px; }
  .pc-check {
    width: 16px; height: 16px; border-radius: 50%;
    border: 1.5px solid var(--muted); flex-shrink: 0;
    transition: all var(--dur-base);
  }
  .pc-check.done { background: #22c55e; border-color: #22c55e; }

  .pc-body  { flex: 1; display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .pc-name  { font-size: .83rem; font-weight: 500; color: var(--text); }
  .pc-diff  { font-size: .65rem; font-weight: 700; flex-shrink: 0; }

  .pc-arrow { font-size: .75rem; color: var(--muted); transition: all var(--dur-fast); }
  .problem-card:hover .pc-arrow { color: var(--accent); }

  /* Bottom CTA */
  .bottom-cta { text-align: center; padding: 24px 0 72px; border-top: 1px solid var(--border); }
  .bottom-cta p { color: var(--dim); font-size: .85rem; margin-bottom: 12px; }
  .cta-row { display: flex; justify-content: center; gap: 10px; flex-wrap: wrap; }
</style>

<script define:vars={{ total }}>
  const KEY    = 'blind75-solved';
  const solved = new Set(JSON.parse(localStorage.getItem(KEY) || '[]'));

  function sync() {
    let count = 0;
    solved.forEach(slug => {
      const chk  = document.getElementById(`chk-${slug}`);
      const card = chk?.closest('.problem-card');
      if (chk)  { chk.classList.add('done'); count++; }
      if (card) card.classList.add('solved');
    });
    const bar   = document.getElementById('progress-bar');
    const label = document.getElementById('progress-label');
    if (bar)   bar.style.width   = (count / total * 100) + '%';
    if (label) label.textContent = `${count} / ${total} solved`;
  }
  sync();
</script>
