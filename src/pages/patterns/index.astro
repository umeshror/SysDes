---
/**
 * patterns/index.astro — Patterns landing page
 * Shows hero + filter grid of all 20 patterns.
 */
import Base from '../../layouts/Base.astro';
import Navbar from '../../components/Navbar.astro';
import patterns from '../../data/patterns.json';

const allTags = ['Array','Tree','Graph','DP','Heap','LinkedList','Stack','Backtracking','Bit'];
---

<Base
  title="20 Essential Coding Interview Patterns — Umesh Saruk"
  description="Master the 20 reusable patterns that explain every FAANG coding question — with live animations, Python & Java code, and FAANG-depth walkthroughs."
>
  <Navbar active="patterns" />

  <!-- ── Hero ── -->
  <header class="hero">
    <div class="hero-badge">
      <span class="dot"></span>
      20 Mastery Blueprints — Animated + Editorial
    </div>
    <h1>Essential Coding Interview <span class="accent">Patterns</span></h1>
    <p>
      Stop memorising solutions. Master the 20 reusable patterns that explain <em>every</em>
      FAANG coding question — with live animations, Python &amp; Java code, and FAANG-depth walkthroughs.
    </p>
    <div class="stats">
      <div class="stat"><span class="stat-val">20</span><span class="stat-label">Patterns</span></div>
      <div class="stat"><span class="stat-val">20</span><span class="stat-label">Animations</span></div>
      <div class="stat"><span class="stat-val">40+</span><span class="stat-label">Code Tabs</span></div>
      <div class="stat"><span class="stat-val">100%</span><span class="stat-label">Free</span></div>
    </div>
    <div class="hero-progress">
      <div class="hp-row">
        <span class="hp-text">Mastery Progress</span>
        <span class="hp-count" id="progress-text">0 / 20 mastered</span>
      </div>
      <div class="hp-bar"><div class="hp-fill" id="hp-fill"></div></div>
    </div>
  </header>

  <!-- ── Grid ── -->
  <section class="grid-section container">
    <div class="grid-header">
      <h2>All 20 Patterns</h2>
      <div class="filter-bar" id="filter-bar">
        <button class="filter-btn active" data-tag="all">All</button>
        {allTags.map(t => (
          <button class="filter-btn" data-tag={t}>{t}</button>
        ))}
      </div>
    </div>

    <div class="patterns-grid" id="patterns-grid">
      {patterns.map(p => (
        <a
          href={`/patterns/${p.slug}/`}
          class="p-card"
          data-tags={p.tags.join(',')}
          data-num={p.num}
        >
          <div class="p-card-top">
            <div class="p-num-badge">{String(p.num).padStart(2,'0')}</div>
            <div class="p-card-meta">
              <div class="p-name">{p.name}</div>
              <div class="p-type">{p.type}</div>
            </div>
            <span class="mastered-badge">✓ Done</span>
          </div>
          <div class="p-desc">{p.desc}</div>
          <div class="p-footer">
            <span class="chip chip-warn">{p.time}</span>
            <span class="chip chip-purple">{p.space}</span>
            {p.tags.map(t => <span class="chip chip-accent">{t}</span>)}
            <span class="p-arrow">→</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ── CTA ── -->
  <div class="bottom-cta">
    <p>Ready to tackle the full problem set?</p>
    <div class="cta-row">
      <a href="/blind75/" class="btn btn-outline">Blind 75 →</a>
      <a href="/top150/"  class="btn btn-outline">Top 150 →</a>
      <a href="/sysdes/"  class="btn btn-primary">System Design Playbook →</a>
    </div>
  </div>

</Base>

<style>
  /* ── Hero */
  .hero {
    max-width: 860px; margin: 0 auto;
    padding: 68px 2rem 52px; text-align: center;
  }
  .hero-badge {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--card); border: 1px solid var(--border);
    border-radius: 999px; padding: 5px 16px;
    font-size: .75rem; color: var(--muted); margin-bottom: 20px;
  }
  .dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--accent); box-shadow: 0 0 8px var(--accent);
    animation: pulse 2s infinite;
  }
  @keyframes pulse { 0%,100%{opacity:1;}50%{opacity:.4;} }
  .hero h1 { font-size: clamp(1.9rem,4.5vw,3rem); font-weight: 800; line-height: 1.1; margin-bottom: 16px; }
  .accent { color: var(--accent); }
  .hero p { font-size: 1rem; color: var(--dim); line-height: 1.8; max-width: 620px; margin: 0 auto 32px; }

  .stats { display: flex; justify-content: center; gap: 36px; flex-wrap: wrap; margin-bottom: 32px; }
  .stat { text-align: center; }
  .stat-val   { display: block; font-size: 2rem; font-weight: 800; color: var(--accent); }
  .stat-label { font-size: .68rem; color: var(--muted); text-transform: uppercase; letter-spacing: .5px; }

  .hero-progress {
    max-width: 440px; margin: 0 auto;
    background: var(--card); border: 1px solid var(--border);
    border-radius: 10px; padding: 14px 18px 16px;
  }
  .hp-row  { display: flex; justify-content: space-between; font-size: .75rem; color: var(--muted); margin-bottom: 8px; }
  .hp-bar  { background: var(--border); border-radius: 4px; height: 5px; }
  .hp-fill {
    background: linear-gradient(90deg, var(--accent), var(--accent2));
    height: 100%; border-radius: 4px; width: 0;
    transition: width .5s var(--ease);
  }

  /* ── Grid */
  .grid-section { padding-bottom: 72px; }
  .grid-header  {
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 12px; margin-bottom: 24px;
  }
  .grid-header h2 { font-size: 1rem; font-weight: 700; }
  .filter-bar { display: flex; gap: 6px; flex-wrap: wrap; }
  .filter-btn {
    font-size: .7rem; font-weight: 600; padding: 4px 13px; border-radius: 999px;
    border: 1px solid var(--border); background: transparent; color: var(--muted);
    cursor: pointer; transition: all var(--dur-fast); font-family: var(--font-body);
  }
  .filter-btn:hover         { border-color: var(--accent); color: var(--accent); }
  .filter-btn.active        { background: var(--accent); color: var(--bg); border-color: var(--accent); }

  .patterns-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 14px;
  }

  /* ── Card */
  .p-card {
    background: var(--card); border: 1px solid var(--border);
    border-radius: 12px; padding: 18px;
    text-decoration: none; display: flex; flex-direction: column; gap: 10px;
    transition: border-color var(--dur-base), transform var(--dur-base), box-shadow var(--dur-base);
    position: relative;
  }
  .p-card:hover {
    border-color: var(--accent); transform: translateY(-3px);
    box-shadow: 0 8px 28px rgba(0,255,213,.07);
  }
  .p-card.mastered { border-color: rgba(0,255,159,.3); }
  .p-card-top { display: flex; align-items: center; gap: 10px; }
  .p-num-badge {
    width: 34px; height: 34px; border-radius: 7px;
    background: var(--surface); border: 1px solid var(--border);
    display: flex; align-items: center; justify-content: center;
    font-size: .68rem; font-weight: 700; color: var(--muted); flex-shrink: 0;
  }
  .p-card.mastered .p-num-badge { background: rgba(0,255,159,.1); border-color: rgba(0,255,159,.3); color: var(--success); }
  .p-card-meta { flex: 1; }
  .p-name { font-size: .9rem; font-weight: 700; color: var(--text); }
  .p-type { font-size: .68rem; color: var(--muted); font-family: var(--font-code); }
  .mastered-badge {
    font-size: .6rem; font-weight: 700; padding: 2px 7px; border-radius: 999px;
    background: rgba(0,255,159,.1); border: 1px solid rgba(0,255,159,.3);
    color: var(--success); display: none;
  }
  .p-card.mastered .mastered-badge { display: block; }
  .p-desc { font-size: .78rem; color: var(--dim); line-height: 1.6; }
  .p-footer { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
  .p-arrow { margin-left: auto; font-size: .78rem; color: var(--muted); transition: all var(--dur-fast); }
  .p-card:hover .p-arrow { color: var(--accent); transform: translateX(3px); }

  /* ── Bottom CTA */
  .bottom-cta {
    text-align: center; padding: 28px 2rem 72px;
    border-top: 1px solid var(--border);
  }
  .bottom-cta p { font-size: .88rem; color: var(--dim); margin-bottom: 14px; }
  .cta-row { display: flex; justify-content: center; gap: 10px; flex-wrap: wrap; }
</style>

<script>
  // ── Mastery from localStorage
  const KEY = 'patterns-mastered';
  const mastered: Set<string> = new Set(JSON.parse(localStorage.getItem(KEY) || '[]'));

  function syncMastery() {
    let count = 0;
    document.querySelectorAll<HTMLElement>('.p-card').forEach(card => {
      if (mastered.has(card.dataset.num!)) { card.classList.add('mastered'); count++; }
    });
    const pct = (count / 20 * 100).toFixed(0);
    (document.getElementById('hp-fill')! as HTMLElement).style.width = pct + '%';
    document.getElementById('progress-text')!.textContent = `${count} / 20 mastered`;
  }
  syncMastery();

  // ── Filter
  document.getElementById('filter-bar')!.addEventListener('click', e => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.filter-btn');
    if (!btn) return;
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const tag = btn.dataset.tag!;
    document.querySelectorAll<HTMLElement>('.p-card').forEach(card => {
      const tags = card.dataset.tags || '';
      card.style.display = (tag === 'all' || tags.includes(tag)) ? '' : 'none';
    });
  });
</script>
