---
/**
 * ProblemLayout.astro — Shared layout for Blind 75 and Top 150 problem pages.
 * Features: collapsible grouped sidebar, search, solved-counter, prev/next nav.
 *
 * Props:
 *   currentSlug  — slug of the active problem
 *   title        — page title
 *   description  — meta description
 *   sections     — grouped problem list (from blind75.json or top150.json)
 *   storageKey   — localStorage key for solved tracking ('blind75-solved' | 'top150-solved')
 *   totalCount   — total problems (75 or 150)
 *   sectionLabel — 'Blind 75' or 'Top 150'
 */
import Base from './Base.astro';
import Navbar from '../components/Navbar.astro';

export interface Problem {
  num: number;
  slug: string;
  name: string;
  diff: string;
  file: string;
}
export interface Section {
  title: string;
  problems: Problem[];
}

export interface Props {
  currentSlug: string;
  title: string;
  description?: string;
  sections: Section[];
  storageKey: string;
  totalCount: number;
  sectionLabel: string;
  active?: string; // navbar active item
}

const {
  currentSlug,
  title,
  description,
  sections,
  storageKey,
  totalCount,
  sectionLabel,
  active = 'blind75',
} = Astro.props;

// Find current problem + prev/next
const allProblems = sections.flatMap(s => s.problems);
const currentIdx  = allProblems.findIndex(p => p.slug === currentSlug);
const current     = allProblems[currentIdx];
const prev        = currentIdx > 0 ? allProblems[currentIdx - 1] : null;
const next        = currentIdx < allProblems.length - 1 ? allProblems[currentIdx + 1] : null;

// Determine which section is active (for default expanded state)
const currentSection = sections.find(s => s.problems.some(p => p.slug === currentSlug));

// Diff colour mapping
function diffClass(diff: string) {
  if (diff === 'Easy')   return 'diff-easy';
  if (diff === 'Hard')   return 'diff-hard';
  return 'diff-medium';
}
---

<Base title={title} description={description}>
  <Navbar active={active} />

  <div class="pl-wrap">

    <!-- ── Sidebar ── -->
    <nav class="pl-sidebar" aria-label={`${sectionLabel} Navigation`}>
      <div class="pl-sidebar-inner">

        <div class="pl-header">
          <h1 class="pl-title">{sectionLabel}</h1>
          <p class="pl-sub">FAANG Interview Essentials</p>
        </div>

        <div class="pl-search-wrap">
          <input
            type="text"
            class="pl-search"
            id="pl-search"
            placeholder="Search problems…"
            autocomplete="off"
          />
        </div>

        <div class="pl-list" id="pl-list">
          {sections.map(section => (
            <div
              class:list={['pl-module', { expanded: section.title === currentSection?.title }]}
              data-section={section.title}
            >
              <button class="pl-module-title">
                {section.title}
                <svg class="pl-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </button>
              <div class="pl-module-items">
                {section.problems.map(p => (
                  <a
                    href={`/${active}/${p.slug}/`}
                    class:list={['pl-item', { 'pl-active': p.slug === currentSlug }]}
                    data-slug={p.slug}
                    data-name={p.name.toLowerCase()}
                  >
                    <span class="pl-num">{p.num}</span>
                    <span class="pl-name">{p.name}</span>
                    <span class:list={['pl-diff', diffClass(p.diff)]}>{p.diff[0]}</span>
                    <span class="pl-check" id={`chk-${p.slug}`}></span>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>

        <div class="pl-footer">
          <div class="pl-progress-label">
            <span id="solved-count">0</span> / {totalCount} solved
          </div>
          <div class="pl-bar-wrap">
            <div class="pl-bar-fill" id="progress-fill"></div>
          </div>
        </div>
      </div>
    </nav>

    <!-- ── Main content ── -->
    <main class="pl-main">
      <slot />

      <!-- Prev / Next -->
      <nav class="page-nav" aria-label="Problem navigation">
        {prev
          ? <a href={`/${active}/${prev.slug}/`} class="pnav-btn">← {prev.name}</a>
          : <span></span>
        }
        <a href={`/${active}/`} class="pnav-btn pnav-home">{sectionLabel}</a>
        {next
          ? <a href={`/${active}/${next.slug}/`} class="pnav-btn">{next.name} →</a>
          : <span></span>
        }
      </nav>
    </main>

  </div>
</Base>

<style>
  /* ── Layout */
  .pl-wrap { display: flex; min-height: calc(100vh - var(--navbar-h)); }

  /* ── Sidebar */
  .pl-sidebar {
    width: var(--sidebar-w); min-width: var(--sidebar-w);
    background: var(--sidebar-bg); border-right: 1px solid var(--border);
    position: sticky; top: var(--navbar-h);
    height: calc(100vh - var(--navbar-h));
    display: flex; flex-direction: column; overflow: hidden;
    transition: background var(--dur-base) var(--ease), border-color var(--dur-base) var(--ease);
  }
  .pl-sidebar-inner { display: flex; flex-direction: column; height: 100%; }

  .pl-header { padding: 16px 16px 12px; border-bottom: 1px solid var(--border); flex-shrink: 0; }
  .pl-title  { font-size: 1rem; font-weight: 700; color: var(--accent); }
  .pl-sub    { font-size: .68rem; color: var(--muted); margin-top: 2px; }

  /* Search */
  .pl-search-wrap { padding: 10px 12px; border-bottom: 1px solid var(--border); flex-shrink: 0; }
  .pl-search {
    width: 100%; background: var(--bg); border: 1px solid var(--border);
    border-radius: 6px; padding: 6px 10px; font-size: .78rem; color: var(--text);
    font-family: var(--font-body);
    transition: border-color var(--dur-fast);
  }
  .pl-search:focus { outline: none; border-color: var(--accent); }

  /* Problem list */
  .pl-list  { flex: 1; overflow-y: auto; padding: 4px 0; }

  .pl-module { border-bottom: 1px solid var(--border); }
  .pl-module-title {
    width: 100%; background: none; border: none; cursor: pointer;
    padding: 9px 14px; font-size: .7rem; font-weight: 700; letter-spacing: .5px;
    text-transform: uppercase; color: var(--muted); font-family: var(--font-body);
    display: flex; align-items: center; justify-content: space-between;
    transition: color var(--dur-fast);
  }
  .pl-module-title:hover { color: var(--text); }
  .pl-chevron { transform: rotate(-90deg); transition: transform var(--dur-base); }
  .pl-module.expanded .pl-chevron { transform: rotate(0deg); }

  .pl-module-items { display: none; }
  .pl-module.expanded .pl-module-items { display: block; }

  .pl-item {
    display: flex; align-items: center; gap: 7px;
    padding: 7px 14px; font-size: .78rem;
    color: var(--sidebar-item); text-decoration: none; border-left: 3px solid transparent;
    transition: all var(--dur-fast) var(--ease);
  }
  .pl-item:hover   { background: color-mix(in srgb, var(--accent) 5%, transparent); color: var(--text); }
  .pl-item.pl-active {
    background: var(--sidebar-active-bg); border-left-color: var(--accent);
    color: var(--sidebar-active-text);
  }
  .pl-num   { width: 22px; font-size: .65rem; font-weight: 700; color: var(--muted); flex-shrink: 0; }
  .pl-active .pl-num { color: var(--sidebar-active-text); }
  .pl-name  { flex: 1; line-height: 1.3; }
  .pl-diff  { font-size: .6rem; font-weight: 700; flex-shrink: 0; }
  .diff-easy   { color: #22c55e; }
  .diff-medium { color: #f59e0b; }
  .diff-hard   { color: #ef4444; }
  .pl-check {
    width: 14px; height: 14px; border-radius: 50%;
    border: 1px solid var(--muted); flex-shrink: 0;
    transition: all var(--dur-base);
  }
  .pl-check.done { background: var(--success); border-color: var(--success); }

  /* Search hidden state */
  .pl-item.hidden { display: none; }

  /* Progress footer */
  .pl-footer { padding: 12px 14px; border-top: 1px solid var(--border); flex-shrink: 0; }
  .pl-progress-label { font-size: .7rem; color: var(--muted); margin-bottom: 6px; }
  .pl-bar-wrap  { background: var(--border); border-radius: 4px; height: 4px; }
  .pl-bar-fill  { background: linear-gradient(90deg, var(--accent), var(--accent2)); height: 100%; border-radius: 4px; width: 0; transition: width .4s var(--ease); }

  /* ── Main */
  .pl-main { flex: 1; padding: 36px 48px 80px; max-width: calc(100% - var(--sidebar-w)); }

  /* ── Prev / Next */
  .page-nav {
    display: flex; justify-content: space-between; align-items: center;
    margin-top: 48px; padding-top: 20px; border-top: 1px solid var(--border); gap: 12px;
  }
  .pnav-btn {
    color: var(--muted); text-decoration: none; font-size: .8rem;
    padding: 7px 14px; border: 1px solid var(--border); border-radius: 6px;
    background: var(--card); transition: all var(--dur-base) var(--ease);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 240px;
  }
  .pnav-btn:hover  { border-color: var(--accent); color: var(--accent); }
  .pnav-home       { margin: 0 auto; max-width: none; }

  /* ── Responsive */
  @media (max-width: 768px) {
    .pl-sidebar { display: none; }
    .pl-main    { padding: 24px 20px 60px; max-width: 100%; }
  }
</style>

<script define:vars={{ storageKey, totalCount }}>
  // ── Solved state
  const solved = new Set(JSON.parse(localStorage.getItem(storageKey) || '[]'));

  function syncUI() {
    let count = 0;
    solved.forEach(slug => {
      const chk = document.getElementById(`chk-${slug}`);
      if (chk) { chk.classList.add('done'); count++; }
    });
    const fill  = document.getElementById('progress-fill');
    const label = document.getElementById('solved-count');
    if (fill)  fill.style.width = (count / totalCount * 100) + '%';
    if (label) label.textContent = String(count);
  }
  syncUI();

  // ── "Mark solved" global handler (called from content pages)
  window.markSolved = function(slug, btn) {
    if (!solved.has(slug)) {
      solved.add(slug);
      localStorage.setItem(storageKey, JSON.stringify([...solved]));
    }
    if (btn) { btn.textContent = '✓ Solved!'; btn.classList.add('solved'); }
    const chk = document.getElementById(`chk-${slug}`);
    if (chk) chk.classList.add('done');
    syncUI();
  };

  // ── Sidebar module toggle
  document.querySelectorAll('.pl-module-title').forEach(btn => {
    btn.addEventListener('click', () => {
      btn.closest('.pl-module')?.classList.toggle('expanded');
    });
  });

  // ── Search
  document.getElementById('pl-search')?.addEventListener('input', e => {
    const q = e.target.value.toLowerCase().trim();
    document.querySelectorAll('.pl-module').forEach(module => {
      let visible = 0;
      module.querySelectorAll('.pl-item').forEach(item => {
        const match = !q || item.dataset.name.includes(q);
        item.classList.toggle('hidden', !match);
        if (match) visible++;
      });
      const titleMatch = !q || module.dataset.section.toLowerCase().includes(q);
      module.style.display = (visible > 0 || titleMatch) ? '' : 'none';
      if (q && visible > 0) module.classList.add('expanded');
    });
  });
</script>
