---
/**
 * Base.astro — Root HTML shell, imported by every page layout.
 * Contains: <head> with tokens/fonts, SEO meta, slot for body content.
 */
export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'System Design & Coding Interview Playbook by Umesh Saruk — Staff Engineer.',
  ogImage = '/images/og-default.png',
} = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />

  <!-- Open Graph -->
  <meta property="og:type"        content="website" />
  <meta property="og:title"       content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image"       content={ogImage} />

  <title>{title}</title>

  <!-- Flash prevention: apply saved theme BEFORE first paint -->
  <script is:inline>
    (function() {
      var t = localStorage.getItem('theme');
      if (t === 'light') document.documentElement.setAttribute('data-theme', 'light');
    })();
  </script>

  <!-- Highlight.js for code blocks -->
  <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark.min.css" />

  <!-- Global design system -->
  <link rel="stylesheet" href="/src/styles/global.css" />
</head>
<body>
  <slot />
</body>
</html>
