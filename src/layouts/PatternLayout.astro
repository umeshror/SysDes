---
/**
 * PatternLayout.astro — Shared layout for all 20 coding-pattern pages.
 * Renders: sticky Navbar, left sidebar with full pattern list, main content area.
 *
 * Props:
 *   currentNum (number) — 1-indexed position of the current pattern
 *   title, description — passed to Base.astro <head>
 */
import Base from './Base.astro';
import Navbar from '../components/Navbar.astro';
import patterns from '../data/patterns.json';

export interface Props {
  currentNum: number;
  title: string;
  description?: string;
}

const { currentNum, title, description } = Astro.props;

const prev = patterns.find(p => p.num === currentNum - 1);
const next = patterns.find(p => p.num === currentNum + 1);
const current = patterns.find(p => p.num === currentNum)!;
---

<Base title={title} description={description}>

  <Navbar active="patterns" />

  <div class="pl-wrap">

    <!-- ── Sidebar ──────────────────────────────────────────── -->
    <nav class="pl-sidebar" aria-label="Patterns Navigation">
      <div class="pl-sidebar-inner">
        <div class="pl-header">
          <h1 class="pl-title">Coding Patterns</h1>
          <p class="pl-sub">20 Mastery Blueprints</p>
        </div>
        <div class="pl-list">
          {patterns.map(p => (
            <a
              href={`/patterns/${p.slug}/`}
              class:list={['pl-item', { active: p.num === currentNum }]}
              data-num={p.num}
            >
              <span class="pl-num">{String(p.num).padStart(2,'0')}</span>
              <span class="pl-name">{p.name}</span>
              <span class="pl-dot" id={`dot-${p.num}`}></span>
            </a>
          ))}
        </div>
        <div class="pl-footer">
          <div class="pl-progress-label">
            <span id="solved-count">0</span> / 20 mastered
          </div>
          <div class="pl-bar-wrap">
            <div class="pl-bar-fill" id="progress-fill"></div>
          </div>
        </div>
      </div>
    </nav>

    <!-- ── Main content ─────────────────────────────────────── -->
    <main class="pl-main">
      <slot />

      <!-- Prev / Next navigation -->
      <nav class="page-nav" aria-label="Pattern navigation">
        {prev
          ? <a href={`/patterns/${prev.slug}/`} class="pnav-btn">← {prev.name}</a>
          : <span></span>
        }
        <a href="/patterns/" class="pnav-btn pnav-home">All Patterns</a>
        {next
          ? <a href={`/patterns/${next.slug}/`} class="pnav-btn">{next.name} →</a>
          : <span></span>
        }
      </nav>
    </main>

  </div>

</Base>

<style>
  .pl-wrap {
    display: flex; min-height: calc(100vh - var(--navbar-h));
  }

  /* ── Sidebar */
  .pl-sidebar {
    width: var(--sidebar-w); min-width: var(--sidebar-w);
    background: var(--sidebar-bg); border-right: 1px solid var(--border);
    position: sticky; top: var(--navbar-h);
    height: calc(100vh - var(--navbar-h));
    display: flex; flex-direction: column; overflow: hidden;
    transition: background var(--dur-base) var(--ease), border-color var(--dur-base) var(--ease);
  }
  .pl-sidebar-inner { display: flex; flex-direction: column; height: 100%; }
  .pl-header {
    padding: 18px 16px 14px;
    border-bottom: 1px solid var(--border); flex-shrink: 0;
  }
  .pl-title { font-size: 1rem; font-weight: 700; color: var(--accent); }
  .pl-sub   { font-size: .7rem; color: var(--muted); margin-top: 2px; }

  .pl-list  { flex: 1; overflow-y: auto; padding: 6px 0; }
  .pl-item  {
    display: flex; align-items: center; gap: 10px;
    padding: 8px 14px; font-size: .82rem; color: var(--sidebar-item);
    text-decoration: none; border-left: 3px solid transparent;
    transition: all var(--dur-fast) var(--ease);
  }
  .pl-item:hover  { background: color-mix(in srgb, var(--accent) 5%, transparent); color: var(--text); }
  .pl-item.active {
    background: var(--sidebar-active-bg); border-left-color: var(--accent); color: var(--sidebar-active-text);
  }
  .pl-num  { width: 22px; font-size: .68rem; font-weight: 700; color: var(--sidebar-item); flex-shrink: 0; }
  .pl-item.active .pl-num { color: var(--sidebar-active-text); }
  .pl-name { flex: 1; line-height: 1.3; }
  .pl-dot  {
    width: 6px; height: 6px; border-radius: 50%;
    background: transparent; flex-shrink: 0;
    transition: background var(--dur-slow);
  }
  .pl-dot.done { background: var(--success); box-shadow: 0 0 4px var(--success); }

  .pl-footer { padding: 12px 14px; border-top: 1px solid var(--border); flex-shrink: 0; }
  .pl-progress-label { font-size: .73rem; color: var(--muted); margin-bottom: 6px; }
  .pl-bar-wrap { background: var(--border); border-radius: 4px; height: 4px; }
  .pl-bar-fill { background: var(--accent); height: 100%; border-radius: 4px; width: 0; transition: width .4s var(--ease); }

  /* ── Main */
  .pl-main { flex: 1; max-width: var(--max-w); padding: 44px 48px 80px; }

  /* ── Prev/Next nav */
  .page-nav {
    display: flex; justify-content: space-between; align-items: center;
    margin-top: 56px; padding-top: 22px; border-top: 1px solid var(--border);
    gap: 12px;
  }
  .pnav-btn {
    color: var(--muted); text-decoration: none; font-size: .83rem;
    padding: 7px 14px; border: 1px solid var(--border); border-radius: 6px;
    background: var(--card); transition: all var(--dur-base) var(--ease);
  }
  .pnav-btn:hover          { border-color: var(--accent); color: var(--accent); }
  .pnav-home               { margin: 0 auto; }

  /* ── Responsive */
  @media (max-width: 768px) {
    .pl-sidebar { display: none; }
    .pl-main    { padding: 24px 20px 60px; }
  }
</style>

<script>
  // Sync mastery dots + progress bar from localStorage
  const KEY = 'patterns-mastered';
  const mastered = new Set(JSON.parse(localStorage.getItem(KEY) || '[]'));

  function syncUI() {
    let count = 0;
    mastered.forEach(num => {
      const dot = document.getElementById(`dot-${num}`);
      if (dot) { dot.classList.add('done'); count++; }
    });
    const pct = (count / 20 * 100).toFixed(0);
    const fill = document.getElementById('progress-fill');
    const label = document.getElementById('solved-count');
    if (fill)  fill.style.width = pct + '%';
    if (label) label.textContent = String(count);
  }
  syncUI();
</script>
